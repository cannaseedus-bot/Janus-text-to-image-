{
  "name": "world-of-doom-builder",
  "version": "1.0.0",
  "description": "Professional DOOM-like RPG game studio with addon marketplace",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "studio": "node server.js --mode=studio",
    "marketplace": "node server.js --mode=marketplace",
    "dev": "nodemon server.js",
    "create-addon": "node tools/create-addon.js",
    "package-addon": "node tools/package-addon.js",
    "extract-wad": "node tools/wad-extractor.js"
  },
  "keywords": [
    "doom",
    "rpg",
    "game-studio",
    "addon-marketplace",
    "wad",
    "game-development"
  ],
  "author": "World of DOOM Builder",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "stripe": "^12.0.0",
    "mongodb": "^5.0.0",
    "socket.io": "^4.6.0",
    "sharp": "^0.32.0",
    "archiver": "^5.3.1",
    "unzipper": "^0.10.11"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
